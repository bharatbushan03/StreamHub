# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/streamhub

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# Client URL
CLIENT_URL=http://localhost:5173

# Storage Provider (local or s3)
STORAGE_PROVIDER=local

# Local Storage
LOCAL_UPLOAD_BASE_URL=http://localhost:5000/uploads

# AWS S3 (Optional if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_bucket_name
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_CLOUDFRONT_URL=

# Redis (Required for video processing queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Video Processing
VIDEO_PROCESSING_CONCURRENCY=1
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_PROCESSING_REMOVE_ON_COMPLETE=true
VIDEO_PROCESSING_REMOVE_ON_FAIL=false
ENABLE_WORKER_IN_SERVER=true
DELETE_FILES_ON_VIDEO_DELETE=false

# Email Notifications (Optional)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM=StreamHub <your_email@example.com>
ENABLE_EMAIL_NOTIFICATIONS=false

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173
